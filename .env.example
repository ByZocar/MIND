# =========================
# Database (PostgreSQL)
# =========================
POSTGRES_HOST=localhost
# Host port mapped from the docker container (5433 -> 5432 inside).
# This avoids the clash with a native Postgres service that some
# Windows installs run on 5432 by default.
POSTGRES_PORT=5433
POSTGRES_DB=acv
POSTGRES_USER=acv_admin
POSTGRES_PASSWORD=change_me_in_local

# =========================
# Airflow
# =========================
AIRFLOW_UID=50000
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# =========================
# Kafka
# =========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_METRICS_TOPIC=acv.metrics.v1
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# =========================
# MLflow
# =========================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=acv-window-classification

# =========================
# Project paths
# =========================
DATA_RAW=./data/raw
DATA_INTERIM=./data/interim
DATA_PROCESSED=./data/processed
REPORTS_DIR=./reports

# =========================
# Modeling
# =========================
RANDOM_SEED=42
TARGET_RECALL_CLASS1=0.85
MIN_SPECIFICITY=0.70
